# Free API key from https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=your_groq_key_here

# Optional: any chat model listed at https://console.groq.com/docs/models
# openai/gpt-oss-20b is fast with generous free limits; openai/gpt-oss-120b gives better answers.
GROQ_MODEL=openai/gpt-oss-20b
